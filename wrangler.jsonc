// Cloudflare config for luckielynx.com.
// Serves the built site from ./site and runs worker/index.js for /api/* (game downloads from R2).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luckielynx",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "BUILDS", "bucket_name": "luckielynx-builds" }
  ],
  "vars": {
    "SUPABASE_URL": "https://qeslzsokehipmemjfcva.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFlc2x6c29rZWhpcG1lbWpmY3ZhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIyMjUyNjcsImV4cCI6MjEwNzgwMTI2N30.8GxM7Zqa1YKWIkuVHIu_FE5E35lSL1TK1LRNS3Dsjjw"
  },
  "observability": { "enabled": true }
}
